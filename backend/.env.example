DATABASE_URL=postgresql+asyncpg://bllro:bllro@localhost:5432/bllro
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=480
COOKIE_NAME=bllro_session
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BLOB_BACKEND=local
BLOB_LOCAL_DIR=blob-data
# BLOB_BACKEND=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=bllro
S3_SECRET_KEY=bllrosecret
S3_BUCKET=bllro-documents
S3_REGION=us-east-1

SEED_OFFICER_EMAIL=officer@bllro.local
SEED_OFFICER_PASSWORD=changeme
SEED_OFFICER_NAME=Demo Inspector
SEED_OFFICER_EMPLOYEE_ID=BLLRO-001

# OCR (UB-Mannheim Tesseract on Windows; leave TESSERACT_CMD blank to auto-detect)
TESSERACT_CMD=
OCR_LANGS=eng+ben
OCR_MAX_PAGES=8
OCR_PDF_SCALE=2.0
OCR_MIN_TEXT_CHARS=40
OCR_MAX_BYTES=15728640

# AI assistance (ownership chain check + return notice drafting) via OpenAI.
# Leave OPENAI_API_KEY blank to run with rule-based fallbacks only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=60
